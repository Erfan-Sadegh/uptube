APP_BASE_URL=http://YOUR_SERVER_IP_OR_DOMAIN
FRONTEND_BASE_URL=http://YOUR_SERVER_IP_OR_DOMAIN
YOUTUBE_REDIRECT_URI=http://YOUR_SERVER_IP_OR_DOMAIN/auth/google/callback

POSTGRES_PASSWORD=replace-with-strong-postgres-password
METIS_API_KEY=replace-with-metis-key
AVALAI_API_KEY=replace-with-avalai-key
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key

TRANSCRIPTION_PROVIDER=avalai
HYBRID_TRANSCRIPTION_ENABLED=true
HYBRID_TEXT_MODEL=gpt-4o-mini-transcribe

MAX_VIDEO_DURATION_SECONDS=600
MAX_VIDEO_BYTES=250000000
MAX_JOBS_PER_USER_PER_DAY=5
MAX_ACTIVE_JOBS_PER_USER=1
ARTIFACT_RETENTION_HOURS=3
METIS_PARALLEL_CHUNKS=2
AUDIO_CHUNK_SECONDS=60
YOUTUBE_VIDEO_UPLOAD_CHUNK_MB=32
YOUTUBE_CAPTION_UPLOAD_CHUNK_KB=512
